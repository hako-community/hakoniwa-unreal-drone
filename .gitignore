# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*
Plugins/SharedLibrary/*
SharedLibrary/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Native runtime libraries are distributed separately.
*.dll
*.so
*.dylib
*.lib
*.exp
*.pdb

# External Hakoniwa native SDKs are installed locally for Win64 builds.
Plugins/HakoniwaPdu/Source/ThirdParty/shakoc/

# Cache files for the editor to use
DerivedDataCache/*

# hakodrone（内蔵 FC）一式は native.lock.json の版で取ってくる（scripts/windows/fetch_native.ps1）。git に入れない。
# ThirdParty/HakoDrone/Include/hakodrone.h と ThirdParty/HakoDrone/LICENSE.md は管理する（取得しなくてもコンパイルできる）。
/ThirdParty/HakoDrone/Win64/*
/ThirdParty/HakoDrone/Android/*
# 機体の物理の定義（hakodrone と同じ版で取ってくる）。git に入れない。
/SimModels/courses_drone/
