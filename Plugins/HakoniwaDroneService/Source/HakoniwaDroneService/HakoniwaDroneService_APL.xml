<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ 2026-10-03（related/devai_dll/hakodrone_unreal_drone_migration_20260930.md・A2）:
  hakodrone（libhakodrone.so ＋ libmujoco.so）を APK の lib/arm64-v8a に入れる（dlopen はそこを探す）。
  取得物は scripts/windows/fetch_native.ps1 が native.lock.json の hakodrone_android の版で
  ThirdParty/HakoDrone/Android/arm64-v8a に置く。$S(PluginDir) はこのファイルのあるフォルダ。
-->
<root xmlns:android="http://schemas.android.com/apk/res/android">
	<init>
		<setString result="HakoDroneDir" value="$S(PluginDir)/../../../../ThirdParty/HakoDrone/Android/arm64-v8a"/>
		<log text="HakoniwaDroneService: hakodrone の .so を $S(HakoDroneDir) から APK に入れる"/>
	</init>

	<resourceCopies>
		<isArch arch="arm64-v8a">
			<copyFile src="$S(HakoDroneDir)/libmujoco.so" dst="$S(BuildDir)/libs/arm64-v8a/libmujoco.so"/>
			<copyFile src="$S(HakoDroneDir)/libhakodrone.so" dst="$S(BuildDir)/libs/arm64-v8a/libhakodrone.so"/>
		</isArch>
	</resourceCopies>
</root>
